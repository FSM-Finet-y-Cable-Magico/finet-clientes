# Puertos del portal en la VPS. `docker compose` lee este archivo solo:
#   cp deploy/vps/.env.example deploy/vps/.env
# Cada servicio toma de aquí su puerto y el de los servicios a los que llama.

# Publicados en 127.0.0.1 de la VPS (rango de G2: 8200-8299).
PUERTO_PROXY=8200
PUERTO_MAILPIT_WEB=8225

# Internos: solo entre contenedores, sin salida a la VPS.
PUERTO_CONTROLLER=4000
PUERTO_VIEW=3000
PUERTO_CHATBOT=3001
