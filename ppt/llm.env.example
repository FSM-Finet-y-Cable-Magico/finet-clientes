# Llave del LLM que usa el chatbot de la demo local (rama ppt).
# Cópialo a ppt/.local/llm.env (esa carpeta no va al repo) y pon tu llave:
#   mkdir -p ppt/.local && cp ppt/llm.env.example ppt/.local/llm.env
# La demo usa Groq con su API compatible con OpenAI; la llave se saca en
# https://console.groq.com/keys.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
