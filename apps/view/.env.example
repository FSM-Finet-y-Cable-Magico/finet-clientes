# Copia este archivo a .env y completa los valores para tu entorno local.
# Ninguno de los valores de abajo es real — son placeholders.

# URL del backend (apps/controller) que usa el navegador. Opcional, cae en
# http://localhost:4000/api si se omite (ver app/_lib/api.ts y afines).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL del backend que usan las server actions del portal (app/portal/_lib).
# A diferencia de NEXT_PUBLIC_API_URL, esta no tiene fallback: sin ella el
# portal lanza "API_URL no esta configurada en las variables de entorno".
# Normalmente el mismo valor que NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000/api

# Autenticación — debe coincidir con JWT_SECRET de apps/controller/.env, ya
# que el proxy (proxy.ts) verifica ahi el token que firma el backend.
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"

# URL publica del sitio, usada en metadata/SEO (canonical, Open Graph, JSON-LD
# en app/layout.tsx). Opcional, cae en https://finet.cl si se omite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DSN de Sentry para reportar errores del cliente (app/_lib/logger.ts).
# Opcional: si se omite, simplemente no se reportan errores.
NEXT_PUBLIC_SENTRY_DSN=
