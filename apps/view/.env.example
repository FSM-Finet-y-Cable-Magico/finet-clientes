# Copia este archivo a .env y completa los valores para tu entorno local.
# Ninguno de los valores de abajo es real — son placeholders.

# URL del backend (apps/controller) que usa el navegador. Opcional, cae en
# http://localhost:4000/api si se omite (ver app/_lib/api.ts y afines).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL del backend que usan las server actions del portal (app/portal/_lib).
# A diferencia de NEXT_PUBLIC_API_URL, esta no tiene fallback: sin ella el
# portal lanza "API_URL no esta configurada en las variables de entorno".
# Normalmente el mismo valor que NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000/api

# Autenticación — debe coincidir con JWT_SECRET de apps/controller/.env, ya
# que el proxy (proxy.ts) verifica ahi el token que firma el backend.
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"

# URL publica del sitio, usada en metadata/SEO (canonical, Open Graph, JSON-LD
# en app/layout.tsx). Opcional, cae en https://finet.cl si se omite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: el host propio del sitio de Cable Mágico. Sin ella vive en el host
# de arriba, bajo /cable-magico. Con ella vive en la raíz de ese host, sin
# prefijo, y proxy.ts lo reconoce por el host (app/_lib/company.ts). Se lee al
# compilar. Con dos hosts el navegador tiene que llamar al backend de su mismo
# host: NEXT_PUBLIC_API_URL=/api, con un proxy que mande /api al backend.
# NEXT_PUBLIC_SITE_URL_CABLE_MAGICO=http://cablemagico.localhost:3000

# Opcional: "false" esconde el selector Finet / Cable Mágico de la barra. Sirve
# para la demostración; en producción, con un dominio por empresa, se apaga.
# NEXT_PUBLIC_SELECTOR_EMPRESA=false

# DSN de Sentry para reportar errores del cliente (app/_lib/logger.ts).
# Opcional: si se omite, simplemente no se reportan errores.
NEXT_PUBLIC_SENTRY_DSN=
# CU-76 / RNF-57.1: clave con la que se cifra la cookie del consentimiento de
# cookies (app/_lib/cookies-consentimiento.servidor.ts). Sin ella el banner no
# puede guardar la decision. Cualquier largo: se deriva a 32 bytes por SHA-256.
COOKIE_CONSENTIMIENTO_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
