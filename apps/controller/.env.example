# Copia este archivo a .env y completa los valores para tu entorno local.
# Ninguno de los valores de abajo es real — son placeholders.

# Base de datos (PostgreSQL)
# Requerido. Prisma no tiene fallback: sin esto el backend no levanta.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finet_clientes"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="finet_clientes"

# Autenticación
# Requerido en ambos lados. Debe ser el MISMO valor que JWT_SECRET en
# apps/view/.env — la view verifica el token que firma este backend.
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"

# Sesión
# Opcional, cae en 15 si no se define (ver src/auth/auth.service.ts).
SESSION_INACTIVITY_MINUTES=15

# Entorno
NODE_ENV="development"
# Opcional, cae en 4000 si no se define (ver src/main.ts).
PORT=4000

# CORS
# Origen(es) permitido(s) para el navegador de apps/view. Requerido en
# produccion (ver src/main.ts); en desarrollo, si se omite, se permite todo.
CORS_ORIGIN="http://localhost:3000"
# Usado como audience del JWT y en los links de los correos transaccionales.
FRONTEND_URL="http://localhost:3000"

# SMTP (Mail)
# Todos opcionales — caen en un Mailhog/maildev local si se omiten
# (ver src/mail/mail.service.ts). Para probar correos en local, levanta un
# maildev/mailhog y apunta SMTP_HOST/SMTP_PORT ahi.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portal Clientes <no-reply@finet.cl>"

# FAST.COM (CU-34/35: test de velocidad)
# Requerido para que /diagnostico/servidores funcione. FAST_TOKEN es el token
# publico que usan fast-cli y proyectos similares (no es secreto de Finet,
# pero sin el la ruta responde 503) (ver src/diagnostico/diagnostico.service.ts).
FAST_API_URL="https://api.fast.com/netflix/speedtest/v2"
FAST_TOKEN="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"

# CRM (CU-32/33: cambio de clave WiFi)
# Opcional: si falta, la solicitud igual se registra pero sin la clave
# cifrada, y el CRM debe pedirsela al cliente por otro medio (no bloquea el
# flujo, solo se pierde ese dato) (ver src/portal/portal.service.ts).
# Va la llave PUBLICA RSA del CRM, en base64 de su PEM completo (o el PEM tal
# cual, con saltos de linea reales) — la privada nunca vive en este repo.
CRM_PUBLIC_KEY=

# Asistente virtual (CU-65: widget de chat del sitio)
# Requeridos para que /asistente/mensajes funcione; sin ellos la ruta responde
# 503 (ver src/asistente/asistente.service.ts). CHATBOT_URL es la base de
# finet-chatbot (otro repo), y CHATBOT_API_KEY debe ser el MISMO valor que
# API_KEY en su .env.
CHATBOT_URL="http://localhost:3001"
CHATBOT_API_KEY="cambia-este-valor-por-la-api-key-del-chatbot"
# CU-63: clave con la que finet-chatbot verifica RUTs en
# /asistente/clientes/identificar. Debe ser el MISMO valor que
# CLIENTES_API_KEY en el .env de finet-chatbot. Sin ella la ruta responde 401 y
# el asistente queda en modo de respuestas generales.
ASISTENTE_API_KEY="cambia-este-valor-por-otra-api-key"

# GRUPO 3 (CU-32 → CU-33: cambio de clave WiFi, flujo del acuerdo v2.0 §6.4)
# El portal cifra la clave con la llave publica de G3 y se la manda directo a su
# endpoint. Solo se usa cuando G8 defina el ticket WiFi (TICKET_WIFI_DEFINIDO en
# src/common/pendientes.ts); mientras tanto el CU-32 sigue con CRM_PUBLIC_KEY.
# Si falta alguna, el v2 responde 503 y no envia nada.
# - G3_API_URL: solo el host, sin la ruta.
# - G3_API_KEY: la clave de API que G3 entrega por canal privado (64 hex, va en
#   el header X-API-KEY). Es SECRETA: nunca en el repo ni en el chat.
# - G3_WIFI_PUBLIC_KEY: la llave publica de G3 (RSA-OAEP SHA-256, 3072 bits), en
#   base64 de su PEM o el PEM tal cual. Antes de usarla, verificar su huella
#   (empieza con 038d6a1d y termina en 12ad; la completa esta en el
#   G2-CREDENCIALES-CANAL-WIFI.md de G3):
#   openssl pkey -pubin -in G2-LLAVE-PUBLICA-WIFI.pem -outform DER | openssl dgst -sha256
G3_API_URL=https://team-3-fsm-production.up.railway.app
G3_API_KEY=
G3_WIFI_PUBLIC_KEY=

# GRUPO 8 (API server-to-server del acuerdo del 12-09, §17; contratos de su
# respuesta del 02-10). No se llama a G8 hasta que confirme su §15 (migracion,
# deploy, clave y smoke): lo deciden los huecos de src/common/pendientes.ts.
# - INTEGRACION_G8_API_URL: solo el host de su backend, sin la ruta.
# - INTEGRACION_G8_API_KEY: la clave que G8 entrega por canal privado (va en el
#   header X-API-KEY y cubre las empresas 1 y 2). Es SECRETA: nunca en el repo ni
#   en el chat.
INTEGRACION_G8_API_URL=
INTEGRACION_G8_API_KEY=

# Enlace de pago firmado (CU-68: aviso de corte, RF-50 / RNF-50.1)
# Clave con la que se firman los enlaces directos a pagar que lleva el aviso de
# corte. No hace falta para levantar el backend: solo se usa cuando el CU-68
# despacha, y si falta ese día no sale ningún aviso (queda en el log). Genera
# una con: openssl rand -base64 32 (ver src/common/enlaces/enlace-pago.service.ts).
ENLACE_PAGO_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
